APP_PORT=8080
LOG_LEVEL=INFO

POSTGRES_DB=supplier_risk
POSTGRES_USER=supplier_risk
POSTGRES_PASSWORD=local_mvp_change_me
DATABASE_URL=postgresql+psycopg://supplier_risk:local_mvp_change_me@postgres:5432/supplier_risk

AI_PROVIDER=fake
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# 供应商站点地理编码（高德 Web 服务 Key；留空则新增/修改地址时不自动定位）
AMAP_WEB_SERVICE_KEY=
AMAP_GEOCODE_TIMEOUT_SECONDS=5

# 情报聚合：生成前的 LLM 相关性门控（两段式：门控 → 报告）
# 判定不相关的事件不发起报告调用，落 skipped 并在列表隐藏；分类留空表示关闭门控
INTELLIGENCE_GATE_ENABLED=true
INTELLIGENCE_GATE_CATEGORIES=policy
INTELLIGENCE_GATE_MAX_CONTENT_CHARS=800
INTELLIGENCE_GATE_SCOPE_KEYWORD_LIMIT=40

# 研究搜索 Provider；未配置时研究搜索保持停用，不发起外部请求
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_TIMEOUT_SECONDS=15
# 已配置 Provider 的自然月搜索额度上限；月报默认关闭，真实调用前需单独批准
SEARCH_MONTHLY_LIMIT=1000
# 受控动态页面回退；默认关闭，只有与 Crawl4AI 同一 internal 网络时才开启
RESEARCH_CRAWL4AI_ENABLED=false
RESEARCH_CRAWL4AI_BASE_URL=http://crawl4ai:11235
RESEARCH_CRAWL4AI_API_TOKEN=
RESEARCH_CRAWL4AI_TIMEOUT_SECONDS=120
RESEARCH_BOCHA_MONTHLY_BATCH_LIMIT=450
RESEARCH_BOCHA_MANUAL_RESERVE=300
RESEARCH_BOCHA_SAFETY_RESERVE=250

# 本地研究 Worker：使用 profile research-local-test 显式启动。
# local_lifecycle_test 仅执行带 [local-worker-test] 前缀的测试任务，不访问外网。
# controlled_single_page 只读取任务显式填写的 HTTPS URL。
# topic_source_discovery 按任务主题调用 SEARCH_PROVIDER，并受控读取预算内候选页面；不调用模型。
# legacy 使用既有固定流水线；langgraph 使用相同的安全、预算与工具入口运行受控图。
# 全局默认保留 legacy 作为回滚安全边界；本地手动研究请使用
# scripts/start-research-worker.ps1，它会仅为 Worker 子进程显式切换到 langgraph。
RESEARCH_WORKER_ENABLED=false
RESEARCH_WORKER_MODE=local_lifecycle_test
RESEARCH_ORCHESTRATOR=legacy
RESEARCH_WORKER_POLL_SECONDS=5
RESEARCH_WORKER_LEASE_SECONDS=300
RESEARCH_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
RESEARCH_WORKER_HEARTBEAT_STALE_SECONDS=60
RESEARCH_TOOL_RUN_STALE_SECONDS=1800

# 风险查询助手（Agent）配置
AGENT_MAX_STEPS=6
# 天眼查 MCP 端点、运行密钥、每日/每月额度和启停均在【信息源控制台】统一管理并加密存库。
# 不在 .env 中配置 TYC_API_KEY、TYC_MCP_ENDPOINT 或 AGENT_TYC_*。
# 信息源控制台运行密钥的加密密钥（Fernet base64 32 字节），生产环境必填。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未配置时由 DATABASE_URL 派生密钥，仅建议开发环境使用。
DATA_SOURCE_SECRET_KEY=

# 定时任务（Scheduler）配置
# cron 表达式：分 时 日 月 周
SCHEDULER_COLLECT_CRON=*/30 * * * *
SCHEDULER_EXPIRE_CRON=0 * * * *
SCHEDULER_CLEANUP_CRON=0 3 * * *
# 研究 Scheduler 只创建 queued 任务，不直接搜索、抓取或调用模型。
# 主题或归属管理员留空时对应日报/周报停用；归属账号必须为启用的管理员。
RESEARCH_SCHEDULE_OWNER_USERNAME=
RESEARCH_DAILY_CRON=0 8 * * *
RESEARCH_DAILY_TOPIC=
RESEARCH_WEEKLY_CRON=30 8 * * mon
RESEARCH_WEEKLY_TOPIC=
RESEARCH_MONTHLY_ENABLED=false
RESEARCH_MONTHLY_CRON=0 9 1 * *
RESEARCH_MONTHLY_TOPIC=
# 月报默认最多选择 100 家启用供应商；额度提升后可改为 all 覆盖全部启用供应商。
RESEARCH_MONTHLY_SUPPLIER_SCOPE=limited
RESEARCH_MONTHLY_SUPPLIER_LIMIT=100

# 数据保留期限（天）：信号/AI分析 90、事件/提醒失效后 90、采集运行 30
RETENTION_SIGNAL_DAYS=90
RETENTION_EVENT_DAYS=90
RETENTION_RUN_DAYS=30

# 风险评分配置（JSON 格式，可选；不设置时使用内置默认值）
# 支持的键：rule_version, severity_scores, association_scores,
#   credibility_weight, timeliness_with_date, timeliness_without_date,
#   product_relevance_score, p1_min, p2_min, p3_min, alert_expiry_days,
#   strong_match_types, forced_rules
# RISK_SCORING_CONFIG={"p1_min": 90, "alert_expiry_days": 60}

# 认证与会话（平台本地账号 + 密码 + 服务端会话，不使用企业 OIDC / IdP）
# production 会强制校验独立强密钥、Secure Cookie 和 HTTPS 来源白名单。
APP_ENV=development
# 会话签名密钥：生产环境必填且不少于 32 个字符；开发环境可留空。
SESSION_SECRET=
# 首位平台管理员引导：仅当库内无用户时生效，创建后务必从配置移除。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# 会话策略（可选，带默认值）
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# 本地 http 开发环境保持 false；生产 HTTPS 反向代理后改为 true。
SESSION_SECURE_COOKIE=false
# 跨域来源白名单（逗号分隔，可选；配置后仅允许名单内 Origin 的写请求）
ALLOWED_ORIGINS=

# ── 风险提醒外部通知（4 渠道）──
# 默认全部关闭，避免隐式外发；订阅级别、免打扰等业务配置在 notification_subscriptions 表。
NOTIFY_ENABLED=false
NOTIFY_PUSH_LEVELS=P1,P2
NOTIFY_SCAN_INTERVAL_SECONDS=60
NOTIFY_DINGTALK_ENABLED=false
NOTIFY_DINGTALK_WEBHOOK_URL=
NOTIFY_DINGTALK_SECRET=
NOTIFY_FEISHU_ENABLED=false
NOTIFY_FEISHU_WEBHOOK_URL=
NOTIFY_FEISHU_SECRET=
NOTIFY_SERVERCHAN_ENABLED=false
NOTIFY_SERVERCHAN_SEND_KEY=
NOTIFY_PUSHPLUS_ENABLED=false
NOTIFY_PUSHPLUS_TOKEN=
# 邮件与摘要正文里的平台链接前缀（如 https://risk.example.com）
NOTIFY_FRONTEND_URL=
NOTIFY_HOURLY_LIMIT=20
NOTIFY_MERGE_WINDOW_MINUTES=15
NOTIFY_QUIET_START=22:00
NOTIFY_QUIET_END=08:00
NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_TIMEOUT_SECONDS=10

# ── 风险提醒邮件推送 ──
# 总开关：未开启时用户推送方案不生效；SMTP 密码（授权码）只存环境变量，不入库不落日志。
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_SMTP_HOST=
NOTIFY_EMAIL_SMTP_PORT=465
# ssl（465，默认）| starttls（587）；不支持 25 明文
NOTIFY_EMAIL_SMTP_SECURITY=ssl
NOTIFY_EMAIL_USERNAME=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_FROM_NAME=供应商风险监控
NOTIFY_EMAIL_TIMEOUT_SECONDS=20
NOTIFY_EMAIL_USER_HOURLY_LIMIT=20
NOTIFY_EMAIL_GLOBAL_HOURLY_LIMIT=60
# 月报：每日 09:00 检查上一个自然月，按 (user_id, period) 幂等
NOTIFY_MONTHLY_REPORT_CRON=0 9 * * *
