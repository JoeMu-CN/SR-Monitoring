APP_PORT=8080
LOG_LEVEL=INFO

POSTGRES_DB=supplier_risk
POSTGRES_USER=supplier_risk
POSTGRES_PASSWORD=local_mvp_change_me
DATABASE_URL=postgresql+psycopg://supplier_risk:local_mvp_change_me@postgres:5432/supplier_risk

AI_PROVIDER=fake
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# 风险查询助手（Agent）配置
AGENT_MAX_STEPS=6
# 天眼查核查网关：开启后使用下方 Key 通过 MCP 调用（ai.tianyancha.com 免费注册，tyc_ 开头）
# 真实 Key 只填写在本机 .env（已 gitignore），此处仅保留占位符
TYC_API_KEY=
TYC_MCP_ENDPOINT=https://mcp.tianyancha.com/v1
AGENT_TYC_DAILY_LIMIT=80
AGENT_TYC_MONTHLY_LIMIT=900

# 定时任务（Scheduler）配置
# cron 表达式：分 时 日 月 周
SCHEDULER_COLLECT_CRON=*/30 * * * *
SCHEDULER_EXPIRE_CRON=0 * * * *
SCHEDULER_CLEANUP_CRON=0 3 * * *

# 数据保留期限（天）：信号/AI分析 90、事件/提醒失效后 90、采集运行 30
RETENTION_SIGNAL_DAYS=90
RETENTION_EVENT_DAYS=90
RETENTION_RUN_DAYS=30

# 风险评分配置（JSON 格式，可选；不设置时使用内置默认值）
# 支持的键：rule_version, severity_scores, association_scores,
#   credibility_weight, timeliness_with_date, timeliness_without_date,
#   product_relevance_score, p1_min, p2_min, p3_min, alert_expiry_days,
#   strong_match_types, forced_rules
# RISK_SCORING_CONFIG={"p1_min": 90, "alert_expiry_days": 60}
