# 复制为 deploy/.env.production，并通过部署环境密钥管理注入真实值。
POSTGRES_DB=supplier_risk
POSTGRES_USER=supplier_risk
POSTGRES_PASSWORD=<generate-a-long-random-password>
DATABASE_URL=postgresql+psycopg://supplier_risk:<url-encoded-password>@postgres:5432/supplier_risk

APP_ENV=production
SESSION_SECRET=<at-least-32-random-characters>
DATA_SOURCE_SECRET_KEY=<fernet-key>
SESSION_SECURE_COOKIE=true
PUBLIC_ORIGIN=https://risk.example.com
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
BOOTSTRAP_ADMIN_USERNAME=<one-time-admin-username>
BOOTSTRAP_ADMIN_PASSWORD=<strong-one-time-admin-password>

AI_PROVIDER=fake
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# 天眼查 MCP 端点、运行密钥、每日/每月额度和启停均在数据源控制台配置，不写入生产 .env。

SCHEDULER_COLLECT_CRON=*/30 * * * *
SCHEDULER_EXPIRE_CRON=0 * * * *
SCHEDULER_CLEANUP_CRON=0 3 * * *
RETENTION_SIGNAL_DAYS=90
RETENTION_EVENT_DAYS=90
RETENTION_RUN_DAYS=30
