# 复制为 deploy/.env.production，并通过部署环境密钥管理注入真实值。
POSTGRES_DB=supplier_risk
POSTGRES_USER=supplier_risk
POSTGRES_PASSWORD=<generate-a-long-random-password>
DATABASE_URL=postgresql+psycopg://supplier_risk:<url-encoded-password>@postgres:5432/supplier_risk

APP_ENV=production
ALEMBIC_UPGRADE_TARGET=0027
# 生产必须填写 ACR 的不可变镜像地址（建议使用 digest，不使用 latest）
APP_IMAGE=<your-acr-instance>/supplier-risk-monitoring/app@sha256:c51702ff7ed8eb8768cd1ef30bab91f779fb0b2b3dcdf7100b934414c1062e14
SESSION_SECRET=<at-least-32-random-characters>
DATA_SOURCE_SECRET_KEY=<fernet-key>
SESSION_SECURE_COOKIE=true
PUBLIC_ORIGIN=https://risk.example.com
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
BOOTSTRAP_ADMIN_USERNAME=<null>
BOOTSTRAP_ADMIN_PASSWORD=<null>

AI_PROVIDER=openai-compatible
AI_BASE_URL=https://ws-b7fp0g32jhvslfo1.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.6-plus
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2

# ECS MVP 首次上线关闭研究轨；阶段 0 通过单独覆盖编排和审批后再开启
RESEARCH_TRACK_ENABLED=false
RESEARCH_SCHEDULE_OWNER_USERNAME=
RESEARCH_DAILY_TOPIC=
RESEARCH_WEEKLY_TOPIC=

# 研究搜索 Provider；正式启用前需完成阶段 0 质量、费用与合规验收
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_TIMEOUT_SECONDS=15

SCHEDULER_COLLECT_CRON=*/30 * * * *
SCHEDULER_EXPIRE_CRON=0 * * * *
SCHEDULER_CLEANUP_CRON=0 3 * * *
RETENTION_SIGNAL_DAYS=90
RETENTION_EVENT_DAYS=90
RETENTION_RUN_DAYS=30
